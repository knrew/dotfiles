{
  "include": "./config.jsonc",
  "name": "hyprland",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by": "number",
    "show-special": false
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 60,
    "separate-outputs": true
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu",
    "on-click": "sh ../wayland/power-menu.sh"
  }
}
