{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "enabled_providers": ["opencode-go"],
  "permission": {
    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",

      "git add": "allow",
      "git add *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git checkout": "allow",
      "git checkout *": "allow",
      "git cherry-pick": "allow",
      "git cherry-pick *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git merge": "allow",
      "git merge *": "allow",
      "git pull": "allow",
      "git pull *": "allow",
      "git rebase": "allow",
      "git rebase *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git reset": "allow",
      "git reset *": "allow",
      "git restore": "allow",
      "git restore *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git stash": "allow",
      "git stash *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git switch": "allow",
      "git switch *": "allow",
      "git tag": "allow",
      "git tag *": "allow",
      "git worktree": "allow",
      "git worktree *": "allow",

      "gh --version": "allow",
      "gh --version *": "allow",
      "gh auth status": "allow",
      "gh auth status *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue status": "allow",
      "gh issue status *": "allow",
      "gh issue view": "allow",
      "gh issue view *": "allow",
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh milestone list": "allow",
      "gh milestone list *": "allow",
      "gh pr checkout": "allow",
      "gh pr checkout *": "allow",
      "gh pr checks": "allow",
      "gh pr checks *": "allow",
      "gh pr diff": "allow",
      "gh pr diff *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr status": "allow",
      "gh pr status *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh release download": "allow",
      "gh release download *": "allow",
      "gh release list": "allow",
      "gh release list *": "allow",
      "gh release view": "allow",
      "gh release view *": "allow",
      "gh repo clone": "allow",
      "gh repo clone *": "allow",
      "gh repo list": "allow",
      "gh repo list *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh run download": "allow",
      "gh run download *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh run view": "allow",
      "gh run view *": "allow",
      "gh run watch": "allow",
      "gh run watch *": "allow",
      "gh search": "allow",
      "gh search *": "allow",
      "gh version": "allow",
      "gh version *": "allow",
      "gh workflow list": "allow",
      "gh workflow list *": "allow",
      "gh workflow view": "allow",
      "gh workflow view *": "allow",

      "git push": "ask",
      "git push *": "ask",
      "gh api": "ask",
      "gh api *": "ask",
      "gh auth logout": "ask",
      "gh auth logout *": "ask",
      "gh issue close": "ask",
      "gh issue close *": "ask",
      "gh issue comment": "ask",
      "gh issue comment *": "ask",
      "gh issue create": "ask",
      "gh issue create *": "ask",
      "gh issue edit": "ask",
      "gh issue edit *": "ask",
      "gh issue lock": "ask",
      "gh issue lock *": "ask",
      "gh issue pin": "ask",
      "gh issue pin *": "ask",
      "gh issue reopen": "ask",
      "gh issue reopen *": "ask",
      "gh issue transfer": "ask",
      "gh issue transfer *": "ask",
      "gh issue unlock": "ask",
      "gh issue unlock *": "ask",
      "gh issue unpin": "ask",
      "gh issue unpin *": "ask",
      "gh pr close": "ask",
      "gh pr close *": "ask",
      "gh pr comment": "ask",
      "gh pr comment *": "ask",
      "gh pr create": "ask",
      "gh pr create *": "ask",
      "gh pr edit": "ask",
      "gh pr edit *": "ask",
      "gh pr merge": "ask",
      "gh pr merge *": "ask",
      "gh pr ready": "ask",
      "gh pr ready *": "ask",
      "gh pr reopen": "ask",
      "gh pr reopen *": "ask",
      "gh pr revert": "ask",
      "gh pr revert *": "ask",
      "gh pr review": "ask",
      "gh pr review *": "ask",
      "gh pr update-branch": "ask",
      "gh pr update-branch *": "ask",
      "gh release create": "ask",
      "gh release create *": "ask",
      "gh release edit": "ask",
      "gh release edit *": "ask",
      "gh release upload": "ask",
      "gh release upload *": "ask",
      "gh repo archive": "ask",
      "gh repo archive *": "ask",
      "gh repo create": "ask",
      "gh repo create *": "ask",
      "gh repo edit": "ask",
      "gh repo edit *": "ask",
      "gh repo fork": "ask",
      "gh repo fork *": "ask",
      "gh repo rename": "ask",
      "gh repo rename *": "ask",
      "gh repo set-default": "ask",
      "gh repo set-default *": "ask",
      "gh repo sync": "ask",
      "gh repo sync *": "ask",
      "gh repo unarchive": "ask",
      "gh repo unarchive *": "ask",
      "gh run cancel": "ask",
      "gh run cancel *": "ask",
      "gh run rerun": "ask",
      "gh run rerun *": "ask",
      "gh secret set": "ask",
      "gh secret set *": "ask",
      "gh variable delete": "ask",
      "gh variable delete *": "ask",
      "gh variable set": "ask",
      "gh variable set *": "ask",
      "gh workflow disable": "ask",
      "gh workflow disable *": "ask",
      "gh workflow enable": "ask",
      "gh workflow enable *": "ask",
      "gh workflow run": "ask",
      "gh workflow run *": "ask",

      "gh auth login": "deny",
      "gh auth login *": "deny",
      "gh auth refresh": "deny",
      "gh auth refresh *": "deny",
      "gh auth token": "deny",
      "gh auth token *": "deny",
      "gh issue delete": "deny",
      "gh issue delete *": "deny",
      "gh release delete": "deny",
      "gh release delete *": "deny",
      "gh release delete-asset": "deny",
      "gh release delete-asset *": "deny",
      "gh repo delete": "deny",
      "gh repo delete *": "deny",
      "gh run delete": "deny",
      "gh run delete *": "deny",
      "gh secret delete": "deny",
      "gh secret delete *": "deny",

      "pip": "deny",
      "pip *": "deny",
      "pip3": "deny",
      "pip3 *": "deny",

      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",

      "cargo *": "ask",
      "cargo build": "allow",
      "cargo build *": "allow",
      "cargo check": "allow",
      "cargo check *": "allow",
      "cargo test": "allow",
      "cargo test *": "allow",
      "cargo fmt": "allow",
      "cargo fmt *": "allow",
      "cargo clippy": "allow",
      "cargo clippy *": "allow",
      "cargo +nightly build": "allow",
      "cargo +nightly build *": "allow",
      "cargo +nightly check": "allow",
      "cargo +nightly check *": "allow",
      "cargo +nightly test": "allow",
      "cargo +nightly test *": "allow",
      "cargo +nightly fmt": "allow",
      "cargo +nightly fmt *": "allow",
      "cargo +nightly clippy": "allow",
      "cargo +nightly clippy *": "allow",
      "rustfmt": "allow",
      "rustfmt *": "allow",

      "taplo": "allow",
      "taplo *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
