{
  "cleanupPeriodDays": 60,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": ["WebSearch", "WebFetch"],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh auth token:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh run delete:*)",
      "Bash(gh secret delete:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)"
    ],
    "ask": [
      "Bash(gh auth logout:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue lock:*)",
      "Bash(gh issue pin:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh issue unlock:*)",
      "Bash(gh issue unpin:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr revert:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release upload:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo fork:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo set-default:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh repo unarchive:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh secret set:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh variable set:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh workflow enable:*)",
      "Bash(gh workflow run:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "language": "Japanese",
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "theme": "light",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
